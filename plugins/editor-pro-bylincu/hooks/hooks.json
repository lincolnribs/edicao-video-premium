{
  "description": "Ativa o editor-pro-bylincu automaticamente quando o pedido é de edição de vídeo",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/detectar-video.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
